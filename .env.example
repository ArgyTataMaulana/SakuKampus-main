PORT=3000
NODE_ENV=development
JWT_SECRET=sakukampus-team7-secret-key-2026
COOKIE_SECRET=sakukampus-cookie-secret-2026
DAILY_CHAT_LIMIT=50

# Instruksi Tambahan Kustom SakuBot
SAKUBOT_CUSTOM_INSTRUCTIONS="Selalu berikan estimasi jatah belanja harian mahasiswa dan rekomendasi tips hemat kreatif di Yogyakarta."

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ========================================================
# UNIVERSAL AI ENGINE (Pilih salah satu atau isi dua-duanya)
# ========================================================
# Provider prioritas otomatis: Groq (sangat cepat & stabil) -> Gemini
# Pilihan AI_PROVIDER: "groq" atau "gemini" (opsional, default: auto-detect)
# AI_PROVIDER=groq

# 1. GROQ (Rekomendasi Utama: Gratis & Super Cepat, daftar di console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. GOOGLE GEMINI (Alternatif)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Database (Supabase Cloud PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_publishable_key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
